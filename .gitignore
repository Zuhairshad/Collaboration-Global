# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude-seo runtime state. .claude/settings.json points CLAUDE_SEO_DATA_DIR
# outside the repo; these only appear if the runtime runs without that env var.
/.claude/skills/seo/.venv*
/.claude/skills/seo/ms-playwright/
/.claude/skills/seo/runtime-state.json
/.claude/skills/seo/.runtime-state.next
/.claude/skills/seo/.setup.lock
/.claude/**/__pycache__/
